{
  "name": "luxcss",
  "version": "1.0.0",
  "description": "A small atomic CSS generator that scans used utility classes and writes only the CSS you need.",
  "main": "dist/src/index.js",
  "bin": {
    "luxcss": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "build:css": "ts-node src/cli.ts",
    "editor": "vite --config vite.playground.config.ts",
    "editor:build": "vite build --config vite.playground.config.ts",
    "editor:preview": "vite preview --config vite.playground.config.ts",
    "check": "npm test && npm run lint && npm run build && npm run editor:build",
    "lint": "eslint .",
    "prepack": "npm run build",
    "watch": "ts-node src/cli.ts --watch",
    "start": "npm run watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^5.0.0",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
